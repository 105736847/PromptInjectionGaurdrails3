# Copy to .env.local and adjust. Variables must start with VITE_ to reach the browser code.
#
# In development leave VITE_API_URL empty: the Vite dev server proxies /api/* to
# http://localhost:8000 (see vite.config.js).
#
# For a production build that talks to a deployed FastAPI server:
# VITE_API_URL=https://api.example.com
VITE_API_URL=
