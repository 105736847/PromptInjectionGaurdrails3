# .env – lives in the project root, next to package.json.
# Only variables that start with VITE_ are visible to your React code,
# as import.meta.env.VITE_API_URL. Restart `npm start` after editing this file.
VITE_API_URL=http://localhost:8000

# A different file is used for the production build:
# .env.production → VITE_API_URL=https://api.your-team.example.com

# WARNING: everything here is copied into the JavaScript that EVERY visitor
# downloads. Never put secrets (API keys, database passwords) in a front-end .env.
# Add .env to .gitignore and commit a .env.example without real values instead.
